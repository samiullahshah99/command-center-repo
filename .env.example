# =================================================================
# Command Center — environment variables
# =================================================================
# Copy this file to .env.local and fill in what you need:
#
#   cp .env.example .env.local
#
# Env changes are NOT hot-reloaded — restart the dev server after editing.
# .env.local is gitignored and must stay that way.
#
# NEXT_PUBLIC_* values are inlined into the CLIENT BUNDLE at build time. Never
# put a secret behind that prefix, and note that setting one only as a runtime
# variable has no effect — it must be present at build time (see Dockerfile).


# =================================================================
# Clerk — authentication (REQUIRED to boot)
# =================================================================
# Without the first two, every /dashboard/* route returns 500 with
# "@clerk/backend: Missing publishableKey".
# pk_test_/sk_test_ in development, pk_live_/sk_live_ in production.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# This app serves auth at /auth/sign-in, not Clerk's default /sign-in. If these
# are unset, Clerk redirects to routes that do not exist here.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/sign-up"

# NOTE: @clerk/nextjs v7 does NOT read AFTER_SIGN_IN_URL / AFTER_SIGN_UP_URL.
# Use the FALLBACK_REDIRECT_URL names below, or redirects silently do nothing.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard/overview"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard/overview"


# =================================================================
# Sentry — error tracking
# =================================================================
# DSN: Settings > Projects > [project] > Client Keys (DSN)

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=

# Only the literal string 'true' disables Sentry. Any other value — including
# "false" — leaves it ENABLED. Leave blank to keep Sentry on.
NEXT_PUBLIC_SENTRY_DISABLED=

# BUILD-TIME ONLY, for source map upload. Locally this may instead live in
# .env.sentry-build-plugin (gitignored). Without it the build still succeeds,
# but production stack traces stay minified.
SENTRY_AUTH_TOKEN=


# =================================================================
# App / build
# =================================================================
# NEXT_PUBLIC_APP_URL sets metadataBase in src/app/layout.tsx. Optional.
# BUILD_STANDALONE=true switches next.config.ts to output:'standalone' —
# required for the Docker image, not for local dev.

NEXT_PUBLIC_APP_URL=
BUILD_STANDALONE=


# =================================================================
# Database — Postgres (Drizzle ORM)
# =================================================================
# Provider-agnostic: any standard Postgres connection string works
# (Railway, Neon, Supabase, local).
#
# DATABASE_URL is what the RUNNING APP uses (src/db/index.ts). On Railway this
# should point at postgres.railway.internal so query traffic stays on the
# private network — no proxy latency, no egress cost.
#
# DATABASE_PUBLIC_URL is what MIGRATIONS use (drizzle.config.ts), because
# drizzle-kit runs from a laptop or CI and cannot reach *.railway.internal.
# It falls back to DATABASE_URL when unset, so a local-only setup with a single
# public URL keeps working.

DATABASE_URL=
DATABASE_PUBLIC_URL=


# =================================================================
# ClickUp — system of record for tasks
# =================================================================
# Token: ClickUp > avatar > Settings > Apps > API Token. Starts with pk_.
# Sent as a RAW Authorization header — no "Bearer " prefix.
# CLICKUP_TEAM_ID is the workspace id from GET /api/v2/team.

CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=


# =================================================================
# Fireflies — meeting transcripts
# =================================================================

FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=


# =================================================================
# Slack
# =================================================================
# App "Command Center". Scopes: channels:read, channels:history, groups:read,
# groups:history, chat:write, users:read, app_mentions:read.
# The bot must be invited to every channel it should read.

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_ID=
SLACK_CHANNEL_ID=


# =================================================================
# LLM access — OpenRouter
# =================================================================
# OpenAI-compatible API at https://openrouter.ai/api/v1.
# Server-side only — must NEVER be prefixed NEXT_PUBLIC_.
# Key format: sk-or-v1-...

OPENROUTER_API_KEY=


# =================================================================
# Internal backend API (replaces the original Shopify integration)
# =================================================================
# Endpoints still TBD; kept here so the slot is documented.

BACKEND_API_URL=
BACKEND_API_TOKEN=


# =================================================================
# Notion — blocked on workspace admin
# =================================================================
# Listed so the requirement stays visible; not yet provisioned.

NOTION_API_KEY=
NOTION_DATABASE_ID=


# =================================================================
# Not yet requested — PRD §5.3 / §5.7 / §5.9
# =================================================================
# Placeholders only. Do not provision until the relevant PRD section
# is scheduled.

ZENDESK_API_TOKEN=
ZENDESK_SUBDOMAIN=
KLAVIYO_API_KEY=
MIRO_ACCESS_TOKEN=
